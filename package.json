{
  "name": "dsh-cockpit-startup",
  "version": "1.2.1",
  "description": "Cinematic mech cockpit startup plugin for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "THIRD-PARTY-NOTICES.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "render:video": "python3 scripts/render_whale_video.py",
    "test": "npm run build && node --test test/*.test.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "prepack": "npm run build",
    "pack:release": "node scripts/release.mjs"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "inject": ["@deepseek-ai/dsh-client-ui-settings"], "platform": "web" } },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "author": "wangyiyi2056",
  "repository": { "type": "git", "url": "https://github.com/wangyiyi2056/dsh-cockpit-startup.git" },
  "keywords": ["dsh-plugin", "deepseek-harness", "startup", "cockpit", "animation"]
}
